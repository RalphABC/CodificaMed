# Proveedor del modelo de lenguaje: "ollama" (local) o "groq" (API externa)
LLM_PROVIDER=ollama

# --- Modelo local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# --- API externa (Groq, plan gratuito) ---
# Crea tu clave en https://console.groq.com y ponla SOLO en tu archivo .env
GROQ_API_KEY=your_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Recuperacion de candidatos del catalogo CIE-10 ---
# "embeddings" (principal) o "tfidf" (linea base, no descarga modelos)
RECUPERADOR=embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
TOP_K_CANDIDATES=3
